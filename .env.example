# ── Cloud Autopilot System — Environment Variables ──
# Copy this file to .env and fill in the values.

PROJECT_NAME="Cloud Autopilot System"
ENVIRONMENT="development"

# MongoDB
MONGO_URI="mongodb://localhost:27017/"
MONGO_DB_NAME="cloudcost"

# JWT (change in production!)
JWT_SECRET="change-me-in-production"

# Frontend URL for CORS (set to your Netlify URL in production)
FRONTEND_URL="*"

# SMTP for OTP emails (use Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Encryption key for AWS credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=""

# Email Provider Configuration
EMAIL_PROVIDER="resend" # 'resend' or 'smtp'

# Resend API Key (used if EMAIL_PROVIDER="resend")
RESEND_API_KEY=""
FROM_EMAIL="onboarding@resend.dev"
ENABLE_OTP_LOG_FALLBACK=true

# AWS (optional — users can also connect via Settings page)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"
